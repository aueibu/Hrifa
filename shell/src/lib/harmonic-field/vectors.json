    {"name": "transpositions: tolerance 0.5 c is still too tight for a 1 c miss", "op": "transpose", "gen": {"type": "custom", "text": "100.0 200.0 301.0"}, "rep": "2/1", "select": [0,1,2], "tol": 0.5, "expect": {"complete": 1}},
