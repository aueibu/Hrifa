    {"name": "chords: 12-EDO 4:5:6 tol 10 finds none", "op": "chords", "gen": {"type": "edo", "N": 12}, "rep": "2/1", "select": "all", "mode": 0, "tol": 10, "templates": ["4:5:6"], "expect": {"count": 0}},
    {"name": "chords: 31-EDO 4:5:6:7 tol 6 is on every root (max error 5.18 c)", "op": "chords", "gen": {"type": "edo", "N": 31}, "rep": "2/1", "select": "all", "mode": 0, "tol": 6, "templates": ["4:5:6:7"], "expect": {"count": 31, "maxErr": 5.18}},
    {"name": "chords: two members landing on the same note reject the chord", "op": "chords", "gen": {"type": "custom", "text": "3/2"}, "rep": "2/1", "select": "all", "mode": 0, "tol": 400, "templates": ["4:5:6"], "expect": {"count": 0}},
