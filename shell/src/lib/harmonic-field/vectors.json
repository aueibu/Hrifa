    {"name": "transpositions: tolerance, default 0.01 c: field 0 100 200 301 c with the scale 0 100 200: key 100 would need 300 c but the field has 301, so only 1/1 is complete", "op": "transpose", "gen": {"type": "custom", "text": "100.0 200.0 301.0"}, "rep": "2/1", "select": [0,1,2], "expect": {"complete": 1, "completeIdx": [0]}},
