    {"name": "template: otonal 4:5:6", "op": "template", "input": "4:5:6", "expect": {"utonal": false, "otonal": "4:5:6", "cents": [0, 386.31, 701.96]}},
    {"name": "template: utonal 1/(4:5:6) has the intervals of 10:12:15", "op": "template", "input": " 1/(4 : 5 : 6) ", "expect": {"utonal": true, "otonal": "10:12:15", "cents": [0, 315.64, 701.96]}},
