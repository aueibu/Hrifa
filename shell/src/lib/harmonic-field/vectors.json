{
  "about": "Language-neutral test vectors for the Harmonic Field Lab core. Any port (Python, C++, ...) must reproduce these. Cents compare within 0.001. A 'field' is: generate -> reduce into repeat -> prime filter -> sort -> dedupe. 'primes' omitted = all enabled.",
  "katapayadiTable": {"ka":1,"kha":2,"ga":3,"gha":4,"ca":6,"cha":7,"ja":8,"jha":9,"dha":9,"na":0,"pa":1,"pha":2,"ba":3,"bha":4,"ma":5,"ya":1,"ra":2,"la":3,"va":4,"sa":7,"ha":8},
  "katapayadiTable_about": "Katapayadi consonant -> digit table used by the katapayadi vectors (only unambiguous consonants). Number = digit(2nd syllable)*10 + digit(1st syllable).",
  "cases": [
    {"name": "parse ratio",            "op": "parse", "input": "3/2",     "expect": {"ratio": "3/2"}},
    {"name": "parse colon ratio",      "op": "parse", "input": "5:4",     "expect": {"ratio": "5/4"}},
    {"name": "parse integer",          "op": "parse", "input": "3",       "expect": {"ratio": "3/1"}},
    {"name": "parse dot means cents",  "op": "parse", "input": "701.96",  "expect": {"cents": 701.96, "irrational": true}},
    {"name": "parse cents suffix",     "op": "parse", "input": "386c",    "expect": {"cents": 386, "irrational": true}},
    {"name": "parse EDO step",         "op": "parse", "input": "7\\12",   "expect": {"cents": 700, "irrational": true}},
    {"name": "parse zero rejected",    "op": "parse", "input": "0/1",     "expect": null},
    {"name": "parse junk rejected",    "op": "parse", "input": "abc",     "expect": null},

    {"name": "harmonic 8 (matches Infinitone UI)", "op": "field", "gen": {"type": "harmonic", "H": 8}, "rep": "2/1",
     "expect": {"ratios": ["1/1","9/8","5/4","11/8","3/2","13/8","7/4","15/8"]}},
    {"name": "harmonic 8, primes 2 3 5 only", "op": "field", "gen": {"type": "harmonic", "H": 8}, "rep": "2/1", "primes": [2,3,5],
     "expect": {"ratios": ["1/1","9/8","5/4","3/2","15/8"]}},
    {"name": "subharmonic 8", "op": "field", "gen": {"type": "subharmonic", "H": 8}, "rep": "2/1",
     "expect": {"ratios": ["1/1","16/15","8/7","16/13","4/3","16/11","8/5","16/9"]}},
    {"name": "harmonic 3 in tritave", "op": "field", "gen": {"type": "harmonic", "H": 3}, "rep": "3/1",
     "expect": {"ratios": ["1/1","4/3","5/3","2/1","7/3","8/3"]}},
    {"name": "4-EDO", "op": "field", "gen": {"type": "edo", "N": 4}, "rep": "2/1",
     "expect": {"cents": [0, 300, 600, 900]}},
    {"name": "13-ED3 (Bohlen-Pierce) count and step", "op": "field", "gen": {"type": "edo", "N": 13}, "rep": "3/1",
     "expect": {"count": 13, "cents_at": {"1": 146.304}}},
    {"name": "Pythagorean 7 (box lattice)", "op": "field", "gen": {"type": "additive", "axes": [{"g": "3/2", "n": 7, "ctr": 1}]}, "rep": "2/1",
     "expect": {"ratios": ["1/1","9/8","81/64","4/3","3/2","27/16","243/128"]}},
    {"name": "box 3/2 x 5/4 (3x3)", "op": "field", "gen": {"type": "additive", "axes": [{"g": "3/2", "n": 3, "ctr": 1}, {"g": "5/4", "n": 3, "ctr": 1}]}, "rep": "2/1",
     "expect": {"count": 9}},
    {"name": "diamond 3/2,5/4 distance 1", "op": "field", "gen": {"type": "diamond", "axes": ["3/2","5/4"], "D": 1, "bidir": true}, "rep": "2/1",
     "expect": {"ratios": ["1/1","5/4","4/3","3/2","8/5"]}},
    {"name": "diamond 2 axes distance 2 = 13 points", "op": "field", "gen": {"type": "diamond", "axes": ["3/2","5/4"], "D": 2, "bidir": true}, "rep": "2/1",
     "expect": {"count": 13}},
    {"name": "diamond 3 axes distance 2 = 25 points", "op": "field", "gen": {"type": "diamond", "axes": ["3/2","5/4","7/4"], "D": 2, "bidir": true}, "rep": "2/1",
     "expect": {"count": 25}},
    {"name": "diamond one-directional distance 2", "op": "field", "gen": {"type": "diamond", "axes": ["3/2","5/4"], "D": 2, "bidir": false}, "rep": "2/1",
     "expect": {"ratios": ["1/1","9/8","5/4","3/2","25/16","15/8"]}},
    {"name": "hexany (1 3 5 7 choose 2)", "op": "field", "gen": {"type": "cps", "factors": ["1","3","5","7"], "k": 2}, "rep": "2/1",
     "expect": {"ratios": ["1/1","7/6","5/4","35/24","5/3","7/4"]}},
    {"name": "custom Ptolemy major", "op": "field", "gen": {"type": "custom", "text": "9/8 5/4 4/3 3/2 5/3 15/8 2/1"}, "rep": "2/1",
     "expect": {"ratios": ["1/1","9/8","5/4","4/3","3/2","5/3","15/8"]}},

    {"name": "MOS sizes of 3/2 in 2/1 up to 20", "op": "mos", "generator": "3/2", "rep": "2/1", "maxN": 20,
     "expect": {"sizes": [2, 3, 5, 7, 12, 17]}},

    {"name": "Pythagorean 7 analysis", "op": "analyze", "gen": {"type": "additive", "axes": [{"g": "3/2", "n": 7, "ctr": 1}]}, "rep": "2/1", "select": "all", "mode": 0,
     "expect": {"pattern": "LLsLLLs", "structure": "5L 2s", "primeLimit": 3}},
    {"name": "Pythagorean 7, mode 5 (Aeolian)", "op": "analyze", "gen": {"type": "additive", "axes": [{"g": "3/2", "n": 7, "ctr": 1}]}, "rep": "2/1", "select": "all", "mode": 5,
     "expect": {"pattern": "LsLLsLL", "structure": "5L 2s"}},
    {"name": "harmonic 8 analysis", "op": "analyze", "gen": {"type": "harmonic", "H": 8}, "rep": "2/1", "select": "all", "mode": 0,
     "expect": {"structure": "8 sizes", "primeLimit": 13, "meanTenney": 4.744}},
    {"name": "4-EDO is equal", "op": "analyze", "gen": {"type": "edo", "N": 4}, "rep": "2/1", "select": "all", "mode": 0,
     "expect": {"pattern": "LLLL", "structure": "equal"}},

    {"name": "nearest 7-ED inside 12-EDO", "op": "nearestEd", "gen": {"type": "edo", "N": 12}, "rep": "2/1", "m": 7,
     "expect": {"indices": [0, 2, 3, 5, 7, 9, 10]}},
    {"name": "odd limit 7 inside harmonic 8", "op": "oddLimit", "gen": {"type": "harmonic", "H": 8}, "rep": "2/1", "L": 7,
     "expect": {"indices": [0, 2, 4, 6]}},

    {"name": "lattice: diamond D=1 on generator axes", "op": "lattice", "mode": "gen", "gen": {"type": "diamond", "axes": ["3/2","5/4"], "D": 1, "bidir": true}, "rep": "2/1",
     "expect": {"count": 5, "edges": 4, "coords": {"1/1": [0,0], "4/3": [-1,0], "8/5": [0,-1]}}},
    {"name": "lattice: Pythagorean 7 is a chain", "op": "lattice", "mode": "gen", "gen": {"type": "additive", "axes": [{"g": "3/2", "n": 7, "ctr": 1}]}, "rep": "2/1",
     "expect": {"count": 7, "edges": 6, "coords": {"4/3": [-1], "243/128": [5]}}},
    {"name": "lattice: harmonic 8 on prime axes (2 folded)", "op": "lattice", "mode": "prime", "gen": {"type": "harmonic", "H": 8}, "rep": "2/1",
     "expect": {"axes": [3,5,7,11,13], "count": 8, "edges": 8, "dropped": 2, "coords": {"15/8": [1,1,0,0,0], "9/8": [2,0,0,0,0]}}},
    {"name": "lattice: generator axes unavailable for harmonic", "op": "lattice", "mode": "gen", "gen": {"type": "harmonic", "H": 8}, "rep": "2/1",
     "expect": {"unavailable": true}},
    {"name": "lattice: EDO has nothing on prime axes", "op": "lattice", "mode": "prime", "gen": {"type": "edo", "N": 12}, "rep": "2/1",
     "expect": {"count": 1, "skipped": 11}},

    {"name": "lattice: hexany on factor axes is an octahedron", "op": "lattice", "mode": "cps", "gen": {"type": "cps", "factors": ["1","3","5","7"], "k": 2}, "rep": "2/1",
     "expect": {"count": 6, "edges": 12, "coords": {"1/1": [1,1,0,0], "35/24": [0,0,1,1]}}},
    {"name": "lattice: eikosany factor graph", "op": "lattice", "mode": "cps", "gen": {"type": "cps", "factors": ["1","3","5","7","9","11"], "k": 3}, "rep": "2/1",
     "expect": {"count": 20, "edges": 90}},
    {"name": "chords: hexany has 4 otonal + 4 utonal triads", "op": "cpsChords", "gen": {"type": "cps", "factors": ["1","3","5","7"], "k": 2}, "rep": "2/1",
     "expect": {"harmonic": 4, "subharmonic": 4, "sizes": [3], "contains": {"type": "harmonic", "common": ["1"], "factors": ["3","5","7"]}}},
    {"name": "chords: eikosany has 15 + 15 tetrads", "op": "cpsChords", "gen": {"type": "cps", "factors": ["1","3","5","7","9","11"], "k": 3}, "rep": "2/1",
     "expect": {"harmonic": 15, "subharmonic": 15, "sizes": [4]}},
    {"name": "chords: dekany harmonic 4-note, subharmonic 3-note", "op": "cpsChords", "gen": {"type": "cps", "factors": ["1","3","5","7","9"], "k": 2}, "rep": "2/1",
     "expect": {"harmonic": 5, "subharmonic": 10, "sizes": [3, 4]}},

    {"name": "Scala export of hexany", "op": "scl", "gen": {"type": "cps", "factors": ["1","3","5","7"], "k": 2}, "rep": "2/1", "scaleName": "hexany",
     "expect": {"text": "! hexany.scl\nHarmonic Field Lab subset: hexany\n 6\n!\n 7/6\n 5/4\n 35/24\n 5/3\n 7/4\n 2/1\n"}},

    {"name": "shape: 12-EDO diatonic is proper, not CS", "op": "shape", "gen": {"type": "edo", "N": 12}, "rep": "2/1", "select": [0, 2, 4, 5, 7, 9, 11], "mode": 0,
     "expect": {"variety": [2, 2, 2, 2, 2, 2], "propriety": "proper", "cs": false, "csExample": {"size": 600, "ks": [3, 4]}}},
    {"name": "shape: 1/4-comma meantone diatonic is strictly proper", "op": "shape", "gen": {"type": "additive", "axes": [{"g": "696.5784285c", "n": 7, "ctr": 1}]}, "rep": "2/1", "select": "all", "mode": 0,
     "expect": {"variety": [2, 2, 2, 2, 2, 2], "propriety": "strictly proper", "cs": true}},
    {"name": "shape: Pythagorean diatonic is improper (729/512 > 1024/729)", "op": "shape", "gen": {"type": "additive", "axes": [{"g": "3/2", "n": 7, "ctr": 1}]}, "rep": "2/1", "select": "all", "mode": 0,
