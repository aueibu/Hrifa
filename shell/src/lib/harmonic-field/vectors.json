    {"name": "transpositions: Duodene (3/2 x 5/4 block, 4x3) with Ptolemy's major: the 3/2 axis is fully used (4/3 1/1 3/2 9/8 span all 4 columns) so no shift along it, the 5/4 axis has room for one step down: keys 1/1 and 8/5 only", "op": "transpose", "gen": {"type": "additive", "axes": [{"g": "3/2", "n": 4, "ctr": 1}, {"g": "5/4", "n": 3, "ctr": 1}]}, "rep": "2/1", "selectRatios": ["1/1","9/8","5/4","4/3","3/2","5/3","15/8"], "expect": {"complete": 2, "completeRoots": ["1/1","8/5"], "missing": {"16/15": 2, "9/8": 3, "6/5": 1, "5/4": 3, "4/3": 2, "45/32": 5, "3/2": 1, "5/3": 4, "9/5": 3, "15/8": 4}, "notes": {"8/5": ["8/5","9/5","1/1","16/15","6/5","4/3","3/2"], "6/5": ["6/5",null,"3/2","8/5","9/5","1/1","9/8"]}}},
