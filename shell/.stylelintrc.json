{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "custom-property-pattern": null,
    "selector-class-pattern": null,
    "scss/no-duplicate-mixins": null,
    "declaration-empty-line-before": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "alpha-value-notation": null,
    "custom-property-empty-line-before": null,
    "property-no-vendor-prefix": null,
    "color-function-notation": null,
    "length-zero-no-unit": null,
    "selector-not-notation": null,
    "no-descending-specificity": null,
    "comment-empty-line-before": null,
    "scss/at-mixin-pattern": null,
    "scss/at-rule-no-unknown": null,
    "value-keyword-case": null,
    "media-feature-range-notation": null,
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["global"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/pages/**/*.css", "src/components/**/*.css", "src/ui/**/*.css"],
      "rules": {
        "color-no-hex": true,
        "color-named": "never",
        "function-disallowed-list": ["rgb", "rgba", "hsl", "hsla", "oklch", "lab", "lch"],
        "property-disallowed-list": ["/^--mantine-/", "/^--input-height-/", "/^--ui-/"],
        "declaration-property-value-allowed-list": {
          "/^border(-[a-z]+)*-radius$/": [
            "/^(0|inherit|50%|9999px|var\\(--radius-[a-z-]+\\))( (0|var\\(--radius-[a-z-]+\\)))*$/"
          ],
          "font-family": [
            "/^(inherit|var\\(--mantine-font-family(-headings|-monospace)?\\))$/"
          ],
          "font-size": [
            "/^(inherit|var\\(--mantine-font-size-(xs|sm|md|lg|xl)\\))$/"
          ]
        }
      }
    },
    {
      "files": [
        "src/pages/harmonic-field-lab/**/*.css",
        "src/pages/affine-focus/**/*.css"
      ],
      "rules": {
        "declaration-property-value-allowed-list": {
          "/^border(-[a-z]+)*-radius$/": [
            "/^(0|inherit|50%|9999px|var\\(--radius-[a-z-]+\\))( (0|var\\(--radius-[a-z-]+\\)))*$/"
          ],
          "font-family": [
            "/^(inherit|var\\(--mantine-font-family(-headings|-monospace)?\\))$/"
          ],
          "font-size": [
            "/^(inherit|var\\(--mantine-font-size-(xs|sm|md|lg|xl)\\)|var\\(--lab-(svg-)?fs-[a-z-]+\\)|calc\\(var\\(--lab-fs-small\\) \\* 0\\.85\\))$/"
          ]
        }
      }
    }
  ]
}
